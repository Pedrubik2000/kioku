#!/data/data/com.termux/files/usr/bin/python
"""Bring the desktop (ankidesk_shell.py, the session's main process) to its home page."""
import os
import socket
import sys

PREFIX = "/data/data/com.termux/files/usr"
sys.path.insert(0, os.path.join(PREFIX, "share/ankidx"))
from ankidesk_menu import SHELL_SOCKET  # noqa: E402

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    s.connect(SHELL_SOCKET)
    s.sendall(b"show\n")
except OSError as e:
    sys.exit(f"desktop not running: {e}")
finally:
    s.close()
