+    // QT_ANDROID_DISABLE_ACCESSIBILITY=1: answer every accessibility query
+    // without touching the Qt thread. Checked on each call: Java may ask
+    // before the app's main() has set the variable.
+    static bool disabledByEnvironment()
+    {
+        return qEnvironmentVariableIntValue("QT_ANDROID_DISABLE_ACCESSIBILITY") != 0;
+    }
+
     template <typename Func, typename Ret>
     void runInObjectContext(QObject *context, Func &&func, Ret *retVal)
     {
+        if (disabledByEnvironment())
+            return;
         if (QAndroidPlatformWindow::surfacesCount() == 0) {
             __android_log_print(ANDROID_LOG_WARN, m_qtTag,
                 "Could not run accessibility call in object context, no valid surface.");
